# ==============================================================================
# ROIHAN AI OFFICE — PANDUAN ENVIRONMENT VARIABLES PRODUKSI (ONLINE Rp0)
# Dokumen Acuan: ADDENDUM v2.1 (Online Deployment & Single-Owner Access)
# ==============================================================================
# PERINGATAN KEAMANAN:
# JANGAN PERNAH commit file .env atau secret ke repositori publik/git.
# Isi variabel-variabel ini langsung di dashboard provider hosting (Render / Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTITAS & LINGKUNGAN APLIKASI
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Menetapkan mode runtime produksi dan isolasi keamanan ketat.
APP_ENV=production
APP_MODE=production
APP_DEFAULT_LANGUAGE=id

# Wajib: Ya (Minimal 16 karakter acak)
# Fungsi: Kunci rahasia untuk komunikasi antar-layanan internal backend dan worker.
APP_LOCAL_TOKEN=ganti_dengan_string_acak_minimal_32_karakter_misal_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 2. BASIS DATA POSTGRESQL (NEON FREE TIER)
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Connection string ke PostgreSQL terkelola di Neon.
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<EP_HOST>.neon.tech/<DB_NAME>?sslmode=require
DATABASE_URL=postgresql+psycopg://roihan_owner:PASSWORD_ANDA@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/roihan_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. SINGLE-OWNER AUTHENTICATION (ADDENDUM v2.1)
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Menetapkan email sah pemilik tunggal. Sistem menolak email lain.
OWNER_EMAIL=owner@roihan.id

# Wajib: Opsional (Disarankan untuk keamanan bootstrap awal)
# Fungsi: Token rahasia sekali pakai untuk mengunci endpoint /api/auth/bootstrap.
BOOTSTRAP_TOKEN=token_rahasia_bootstrap_sekali_pakai_32_karakter

# Masa aktif sesi login pemilik (hari)
SESSION_TTL_DAYS=30

# Cookie security flag (Otomatis True saat diakses via HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Proteksi brute-force login
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# 4. KORS & JARINGAN (FRONTEND URL)
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Daftar origin domain frontend yang diizinkan memanggil backend API.
# Format: JSON array string
CORS_ORIGINS=["https://roihan-ai-office.vercel.app","https://roihan.id"]

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI API (KANDIDAT UTAMA)
# ------------------------------------------------------------------------------
# Wajib: Ya (untuk eksekusi fitur AI generatif online)
# Fungsi: Mengaktifkan adapter cloud Gemini tanpa dependensi Ollama.
GEMINI_ENABLED=true
GEMINI_API_KEY=AIzaSy_KUNCI_GEMINI_API_ANDA
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 6. PENGENDALIAN BIAYA & BUDGET (ZERO-COST SAFETY)
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Membatasi penggunaan berbayar tak terduga.
BUDGET_CURRENCY=IDR
BUDGET_MONTHLY_LIMIT=0
BUDGET_ALLOW_PAID_CALLS=false
AI_MAX_TOKENS_CAP=2048
AI_MAX_PROMPT_CHARS=20000

# ------------------------------------------------------------------------------
# 7. WORKER & TASK ENGINE
# ------------------------------------------------------------------------------
# Wajib: Ya
# Fungsi: Menjalankan eksekutor latar belakang untuk audit SEO dan tugas marketing.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_S=2.0
MAX_CONCURRENT_TASKS=1
MAX_RETRIES_PER_TASK=2

# ------------------------------------------------------------------------------
# 8. FRONTEND PROXY SETTINGS (DI VERCEL)
# ------------------------------------------------------------------------------
# Variabel yang harus diset di dashboard Vercel (apps/web):
# API_BASE_URL: URL publik backend Render Anda, misal: https://roihan-ai-office-api.onrender.com
# APP_LOCAL_TOKEN: Harus sama dengan APP_LOCAL_TOKEN yang diset di Render.
