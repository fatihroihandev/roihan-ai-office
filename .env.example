# Roihan Software House - contoh konfigurasi lingkungan.
# Salin ke .env dan isi sesuai kebutuhan. Jangan commit .env.

APP_MODE=local
APP_ENV=development
APP_LOCAL_TOKEN=ganti-dengan-token-acak
APP_DEFAULT_LANGUAGE=id

# Provider lokal
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_S=600
AI_MAX_TOKENS_CAP=2048
AI_MAX_PROMPT_CHARS=20000

# Provider cloud: NONAKTIF secara default (butuh approval, lihat Bagian 8 dan 10)
OPENAI_ENABLED=false
OPENAI_API_KEY=
GEMINI_ENABLED=false
GEMINI_API_KEY=
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=

# Anggaran
BUDGET_CURRENCY=IDR
BUDGET_MONTHLY_LIMIT=0
BUDGET_ALLOW_PAID_CALLS=false

# Penyimpanan dan unggahan
# DATA_DIR=./data
MAX_UPLOAD_MB=10

# Worker task
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_S=1.0

# Office Power Control (Phase 13)
POWER_PAUSE_GRACE_S=20
POWER_INTERRUPT_WAIT_S=10
POWER_CHECKPOINT_INTERVAL_S=20
POWER_CHECKPOINT_KEEP=5

# Cadangan otomatis (Fase 11): salinan database + folder proyek ke data/backups/
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_INCLUDE_PROJECTS=true
BACKUP_MAX_PROJECT_MB=500
RETRY_BACKOFF_BASE_S=5

# Sandbox eksekusi kode (Phase 5). none = eksekusi kode ditolak. wsl = distro WSL2 khusus (lihat README)
SANDBOX_BACKEND=none
SANDBOX_WSL_DISTRO=roihan-sandbox
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=768
SANDBOX_MAX_OUTPUT_KB=64

# Approval: masa berlaku permintaan approval (jam)
APPROVAL_TTL_HOURS=24

# Marketing (Phase 8): usulan bawaan kebijakan data prospek; ubah setelah CEO memutuskan
LEAD_ALLOWED_SOURCES=public_website,public_registry,referral,inbound,event,manual
LEAD_RETENTION_NO_INTERACTION_DAYS=180
LEAD_RETENTION_AFTER_INTERACTION_DAYS=730
LEAD_RETENTION_AUTO_APPLY=false
LEAD_MIN_SCORE_FOR_SALES=40

# Aktivitas eksternal (Phase 9): usulan bawaan; semua pengiriman/publikasi tetap memerlukan approval CEO dan berhenti di kotak keluar
OUTREACH_ALLOWED_CHANNELS=email
OUTREACH_MIN_DAYS_BETWEEN_CONTACTS=14
OUTREACH_MAX_PER_DAY=10
CONTENT_ALLOWED_CHANNELS=blog,website,linkedin,instagram,newsletter
CONTENT_MAX_PUBLISH_PER_DAY=5

# Batas eksekusi
MAX_RETRIES_PER_TASK=2
MAX_CONCURRENT_TASKS=1

# Keamanan
RESTRICT_WORKSPACE_ACCESS=true
REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true
REDACT_SECRETS_IN_LOGS=true
